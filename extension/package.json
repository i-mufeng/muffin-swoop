{
  "name": "swoop-extension",
  "version": "0.8.0",
  "private": true,
  "description": "把浏览器下载交给 Swoop",
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs",
    "build:chromium": "node esbuild.config.mjs --browser=chromium",
    "build:firefox": "node esbuild.config.mjs --browser=firefox",
    "package": "node esbuild.config.mjs && node scripts/package.mjs && node scripts/package-crx.mjs",
    "package:crx": "node scripts/package-crx.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.5",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "happy-dom": "^20.14.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
